{
  "openapi": "3.1.0",
  "info": {
    "title": "Convex Dashboard HTTP routes",
    "description": "Endpoints intended for dashboard use",
    "license": {
      "name": "LicenseRef-FSL-1.1-Apache-2.0",
      "identifier": "LicenseRef-FSL-1.1-Apache-2.0"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api",
      "description": "Deployment API"
    }
  ],
  "paths": {
    "/check_admin_key": {
      "get": {
        "tags": [
          "public_api"
        ],
        "summary": "Check admin key validity",
        "description": "This endpoint checks if the admin key included in the header is valid for\nthis instance. Returns the allowed operations and read-only status for the\nkey so the dashboard can show appropriate disabled states.",
        "operationId": "check_admin_key",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/shapes2": {
      "get": {
        "summary": "Get table shapes",
        "description": "Returns the schema shapes for all tables in the specified component.",
        "operationId": "shapes2",
        "parameters": [
          {
            "name": "component",
            "in": "query",
            "description": "Component ID to get shapes for",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/get_indexes": {
      "get": {
        "summary": "Get database indexes",
        "description": "Returns metadata about database indexes for the specified component.",
        "operationId": "get_indexes",
        "parameters": [
          {
            "name": "component_id",
            "in": "query",
            "description": "Component ID to get indexes for",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetIndexesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/delete_tables": {
      "post": {
        "summary": "Delete database tables",
        "description": "Deletes the specified tables from the database.",
        "operationId": "delete_tables",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteTableArgs"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    },
    "/delete_component": {
      "post": {
        "summary": "Delete component",
        "description": "Deletes the specified component and all its associated data.",
        "operationId": "delete_component",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteComponentArgs"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    },
    "/delete_scheduled_functions_table": {
      "post": {
        "operationId": "delete_scheduled_functions_table",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteScheduledFunctionsTableRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    },
    "/wasm_runtime_policy": {
      "get": {
        "tags": [
          "Static Hermes Wasmtime"
        ],
        "summary": "Read the live primary engine and opposite-engine shadow sampling policy.",
        "operationId": "get_runtime_policy",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimePolicyResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid deployment key header"
          },
          "401": {
            "description": "Deployment key authentication required"
          },
          "403": {
            "description": "Deploy permission required"
          }
        },
        "security": [
          {
            "Deploy Key": []
          }
        ]
      },
      "post": {
        "tags": [
          "Static Hermes Wasmtime"
        ],
        "summary": "Persist and select the runtime policy for newly dispatched invocations.",
        "description": "Existing invocations keep their captured engine. Artifact admission and\nroute quarantines remain authoritative; selecting Wasm does not create a\npair or promote a shadow-only generation. Zero sampling selects primary\nonly.",
        "operationId": "update_runtime_policy",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateRuntimePolicyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimePolicyResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid runtime policy or deployment key header"
          },
          "401": {
            "description": "Deployment key authentication required"
          },
          "403": {
            "description": "Deploy permission required"
          },
          "409": {
            "description": "Stale source or policy, unavailable staging or baseline capacity, changed initialization dependencies, validation timeout, or unavailable durable storage"
          },
          "500": {
            "description": "Update failed; read status before another update"
          }
        },
        "security": [
          {
            "Deploy Key": []
          }
        ]
      }
    },
    "/static_hermes_wasmtime_quarantine": {
      "post": {
        "tags": [
          "Static Hermes Wasmtime"
        ],
        "summary": "Apply a subtractive Wasm route quarantine.",
        "description": "The durable policy is atomically replaced and an immutable snapshot is\npublished for newly resolved invocations. Selectors are exact module paths\nwith an optional exact export name. This handler is mounted only in the\nlocal dashboard/admin router and authenticates a deployment key before\napplying a change.",
        "operationId": "update_static_hermes_wasmtime_quarantine",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateStaticHermesWasmtimeQuarantineRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateStaticHermesWasmtimeQuarantineResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Deploy Key": []
          }
        ]
      }
    },
    "/source_keyed_runtime_active_pair": {
      "get": {
        "tags": [
          "Static Hermes Wasmtime"
        ],
        "summary": "Return the database-committed source package and its load-verified runtime\ngeneration. The source package is read from one database snapshot, and the\nsource-keyed registry ensures the exact immutable generation bound to that\nruntime-content digest before reporting the pair.",
        "operationId": "source_keyed_runtime_active_pair",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceKeyedRuntimeActivePairResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Deploy Key": []
          }
        ]
      }
    },
    "/source_keyed_runtime_readiness": {
      "post": {
        "tags": [
          "Static Hermes Wasmtime"
        ],
        "summary": "Return whether an exact source/generation pair has a retained,\nauthenticated generation with fully initialized runtime capacity.",
        "description": "This endpoint does not change the committed source selection. It prepares\nonly the requested exact generation; the point-in-time response grants no\nactivation authority or reservation and exposes no registry paths or loader\ndetails. Pending responses may include sanitized capacity observations.",
        "operationId": "source_keyed_runtime_readiness",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SourceKeyedRuntimeReadinessRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceKeyedRuntimeReadinessResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Deploy Key": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "DeleteComponentArgs": {
        "type": "object",
        "properties": {
          "componentId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "DeleteScheduledFunctionsTableRequest": {
        "type": "object",
        "properties": {
          "componentId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "DeleteTableArgs": {
        "type": "object",
        "required": [
          "tableNames"
        ],
        "properties": {
          "tableNames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "componentId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "GetIndexesResponse": {
        "type": "object",
        "required": [
          "indexes"
        ],
        "properties": {
          "indexes": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "InFlightInvocationsResponse": {
        "type": "object",
        "required": [
          "existingInvocationsRetainCapturedEngine",
          "staticHermesRouteSpecific",
          "drainWaitSupported",
          "observabilityGap"
        ],
        "properties": {
          "existingInvocationsRetainCapturedEngine": {
            "type": "boolean"
          },
          "aggregateIsolateWorkers": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Aggregate isolate-worker visibility is unavailable at this control\nboundary, so no drain count is claimed.",
            "minimum": 0
          },
          "staticHermesRouteSpecific": {
            "type": "boolean"
          },
          "drainWaitSupported": {
            "type": "boolean"
          },
          "observabilityGap": {
            "type": "string"
          }
        }
      },
      "PrimaryRuntime": {
        "type": "string",
        "enum": [
          "v8",
          "wasm"
        ]
      },
      "QuarantineAction": {
        "type": "string",
        "enum": [
          "quarantine",
          "clear",
          "initialize"
        ]
      },
      "QuarantineEntryResponse": {
        "type": "object",
        "required": [
          "modulePath"
        ],
        "properties": {
          "modulePath": {
            "type": "string"
          },
          "functionName": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "RuntimeMode": {
        "type": "object",
        "required": [
          "primary",
          "shadowBps"
        ],
        "properties": {
          "primary": {
            "$ref": "#/components/schemas/PrimaryRuntime"
          },
          "shadowBps": {
            "type": "integer",
            "format": "int32",
            "maximum": 10000,
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "RuntimePolicy": {
        "type": "object",
        "required": [
          "query",
          "mutation"
        ],
        "properties": {
          "query": {
            "$ref": "#/components/schemas/RuntimeMode"
          },
          "mutation": {
            "$ref": "#/components/schemas/RuntimeMode"
          }
        },
        "additionalProperties": false
      },
      "RuntimePolicyResponse": {
        "type": "object",
        "required": [
          "snapshot",
          "durable",
          "quarantinedSelectors",
          "quarantineInitialized"
        ],
        "properties": {
          "snapshot": {
            "$ref": "#/components/schemas/RuntimePolicySnapshot"
          },
          "durable": {
            "type": "boolean"
          },
          "quarantinedSelectors": {
            "type": "integer",
            "description": "Quarantines still override this policy. A mode update never clears them.",
            "minimum": 0
          },
          "quarantineInitialized": {
            "type": "boolean",
            "description": "An uninitialized or ambiguous quarantine store blocks all Wasm routes."
          },
          "population": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceKeyedRuntimeGroupPopulation"
            }
          },
          "preparationElapsedMs": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          }
        }
      },
      "RuntimePolicySnapshot": {
        "type": "object",
        "required": [
          "revision",
          "policy"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "policy": {
            "$ref": "#/components/schemas/RuntimePolicy"
          }
        },
        "additionalProperties": false
      },
      "SourceKeyedRuntimeActiveGeneration": {
        "type": "object",
        "required": [
          "deploymentSha256",
          "generationManifestSha256",
          "generationSha256"
        ],
        "properties": {
          "deploymentSha256": {
            "type": "string"
          },
          "generationManifestSha256": {
            "type": "string"
          },
          "generationSha256": {
            "type": "string"
          }
        }
      },
      "SourceKeyedRuntimeActivePairResponse": {
        "type": "object",
        "required": [
          "kind",
          "status"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "generation": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SourceKeyedRuntimeActiveGeneration"
              }
            ]
          },
          "source": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SourceKeyedRuntimeActiveSource"
              }
            ]
          },
          "status": {
            "$ref": "#/components/schemas/SourceKeyedRuntimeActivePairStatus"
          }
        }
      },
      "SourceKeyedRuntimeActivePairStatus": {
        "type": "string",
        "enum": [
          "paired",
          "notPaired"
        ]
      },
      "SourceKeyedRuntimeActiveSource": {
        "type": "object",
        "required": [
          "sourcePackageId",
          "sourcePackageSha256"
        ],
        "properties": {
          "sourcePackageId": {
            "type": "string"
          },
          "sourcePackageRuntimeContentSha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourcePackageSha256": {
            "type": "string"
          }
        }
      },
      "SourceKeyedRuntimeCapacity": {
        "type": "object",
        "required": [
          "reason",
          "projectedBytes",
          "softBudgetBytes",
          "hardBudgetBytes",
          "instances",
          "instanceLimit"
        ],
        "properties": {
          "reason": {
            "type": "string"
          },
          "projectedBytes": {
            "type": "integer",
            "minimum": 0
          },
          "softBudgetBytes": {
            "type": "integer",
            "minimum": 0
          },
          "hardBudgetBytes": {
            "type": "integer",
            "minimum": 0
          },
          "instances": {
            "type": "integer",
            "minimum": 0
          },
          "instanceLimit": {
            "type": "integer",
            "minimum": 0
          },
          "cgroupHeadroomBytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      },
      "SourceKeyedRuntimeGroupPopulation": {
        "type": "object",
        "required": [
          "group",
          "target",
          "prepared",
          "active",
          "inProgress"
        ],
        "properties": {
          "group": {
            "type": "string"
          },
          "target": {
            "type": "integer",
            "minimum": 0
          },
          "prepared": {
            "type": "integer",
            "minimum": 0
          },
          "active": {
            "type": "integer",
            "minimum": 0
          },
          "inProgress": {
            "type": "integer",
            "minimum": 0
          },
          "shortfall": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "SourceKeyedRuntimeReadinessRequest": {
        "type": "object",
        "required": [
          "deploymentSha256",
          "generationManifestSha256",
          "generationSha256",
          "sourcePackageRuntimeContentSha256"
        ],
        "properties": {
          "deploymentSha256": {
            "type": "string"
          },
          "generationManifestSha256": {
            "type": "string"
          },
          "generationSha256": {
            "type": "string"
          },
          "sourcePackageRuntimeContentSha256": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "SourceKeyedRuntimeReadinessResponse": {
        "type": "object",
        "required": [
          "deploymentSha256",
          "generationManifestSha256",
          "generationSha256",
          "kind",
          "sourcePackageRuntimeContentSha256",
          "status",
          "preparationElapsedMs"
        ],
        "properties": {
          "deploymentSha256": {
            "type": "string"
          },
          "generationManifestSha256": {
            "type": "string"
          },
          "generationSha256": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "sourcePackageRuntimeContentSha256": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/SourceKeyedRuntimeReadinessStatus"
          },
          "capacity": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SourceKeyedRuntimeCapacity"
              }
            ]
          },
          "population": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceKeyedRuntimeGroupPopulation"
            }
          },
          "preparationElapsedMs": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "SourceKeyedRuntimeReadinessStatus": {
        "type": "string",
        "enum": [
          "ready",
          "capacityUnavailable",
          "notStaged"
        ]
      },
      "UpdateRuntimePolicyRequest": {
        "type": "object",
        "required": [
          "expectedRevision",
          "policy"
        ],
        "properties": {
          "expectedRevision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "policy": {
            "$ref": "#/components/schemas/RuntimePolicy"
          }
        },
        "additionalProperties": false
      },
      "UpdateStaticHermesWasmtimeQuarantineRequest": {
        "type": "object",
        "required": [
          "action",
          "reason",
          "operatorReference"
        ],
        "properties": {
          "action": {
            "$ref": "#/components/schemas/QuarantineAction",
            "description": "`quarantine` adds a sticky selector; `clear` removes only that exact\nselector; `initialize` repairs a missing or ambiguous policy as an\nempty valid snapshot."
          },
          "modulePath": {
            "type": [
              "string",
              "null"
            ],
            "description": "Required for `quarantine` and `clear`; omitted for `initialize`."
          },
          "functionName": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string",
            "description": "Required operator-supplied change rationale. It is bounded and stored\nas policy evidence, not emitted with application values."
          },
          "operatorReference": {
            "type": "string",
            "description": "Required bounded operator/change reference for audit correlation."
          }
        },
        "additionalProperties": false
      },
      "UpdateStaticHermesWasmtimeQuarantineResponse": {
        "type": "object",
        "required": [
          "action",
          "changed",
          "snapshotVersion",
          "entries",
          "inFlightInvocations"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "changed": {
            "type": "boolean"
          },
          "snapshotVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuarantineEntryResponse"
            }
          },
          "inFlightInvocations": {
            "$ref": "#/components/schemas/InFlightInvocationsResponse",
            "description": "Route resolution is invocation-scoped. This update does not reroute or\ninterrupt invocations that already captured their engine choice."
          }
        }
      }
    },
    "securitySchemes": {
      "Deploy Key": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Deploy keys are used for deployment operations. See [deploy key types](https://docs.convex.dev/cli/deploy-key-types) for more information. Use the `Convex ` prefix (e.g., `Convex <deploy_key>`)."
      },
      "OAuth Project Token": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Obtained through a [Convex OAuth application](https://docs.convex.dev/management-api) with project scope. Use the `Convex ` prefix (e.g., `Convex <oauth_project_token>`)."
      },
      "OAuth Team Token": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Obtained through a [Convex OAuth application](https://docs.convex.dev/management-api). Use the `Convex ` prefix (e.g., `Convex <oauth_token>`)."
      },
      "Team Token": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Created in the dashboard under team settings for any team you can manage. Use the `Convex ` prefix (e.g., `Convex <team_token>`)."
      }
    }
  }
}
