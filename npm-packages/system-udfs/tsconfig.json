{
  "include": ["convex/**/*", "convex/_generated/*", "vitest.config.ts"],
  "compilerOptions": {
    "target": "es2022",
    // Preserve assignment-style class fields when modernizing the check target.
    "useDefineForClassFields": false,
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // The backend bundles these sources directly with esbuild.
    "noEmit": true,
    /* allow use of internal Convex APIS */
    "customConditions": ["convex-internal-types"]
  }
}
