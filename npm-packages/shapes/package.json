{
  "name": "shapes",
  "version": "0.1.2",
  "description": "",
  "type": "module",
  "main": "./dist/esm/index.js",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "types": "dist/esm/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && npm run build-esm && npm run build-cjs",
    "build-esm": "tsrs",
    "build-cjs": "mkdir -p dist/cjs && cp -R dist/esm/. dist/cjs && esbuild \"dist/esm/**/*.js\" --outbase=dist/esm --outdir=dist/cjs --format=cjs --target=es2015 --sourcemap && echo '{\"type\": \"commonjs\"}' > dist/cjs/package.json",
    "clean": "rm -rf dist",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests",
    "test-esm": "node -e 'import(\"./dist/esm/index.js\")'"
  },
  "author": "Convex, Inc.",
  "license": "MIT",
  "dependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "jest": "^30.0.0",
    "@types/jest": "^30.0.0",
    "ts-jest": "^29.1.1",
    "@jest/globals": "^30.0.0",
    "@types/node": "^22.0.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "esbuild": "0.27.0"
  }
}
