{
  "compilerOptions": {
    "target": "es2022",
    // Preserve assignment-style class fields when modernizing the check target.
    "useDefineForClassFields": false,
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "customConditions": ["convex-internal-types"],
    "paths": {
      "@common/*": ["./../dashboard-common/src/*"],
      "@ui/*": ["./../@convex-dev/design-system/src/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "*": ["./src/*"]
    }
  },
  // Wildcards skip hidden directories, and Next only adds this include for App Router projects.
  "include": ["next-env.d.ts", ".next/types/**/*.ts", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
