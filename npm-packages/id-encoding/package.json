{
  "name": "id-encoding",
  "version": "0.1.2",
  "description": "",
  "type": "module",
  "main": "./dist/esm/index.js",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "types": "dist/esm/index.d.ts",
  "scripts": {
    "build": "shx rm -rf dist && npm run build-esm && npm run build-cjs",
    "build-esm": "tsrs",
    "build-cjs": "mkdir -p dist/cjs && cp -R dist/esm/. dist/cjs && esbuild \"dist/esm/**/*.js\" --outbase=dist/esm --outdir=dist/cjs --format=cjs --target=es2015 --sourcemap && echo '{\"type\": \"commonjs\"}' > dist/cjs/package.json",
    "clean": "shx rm -rf dist",
    "test": "vitest",
    "test-esm": "node -e 'import(\"./dist/esm/index.js\")'"
  },
  "author": "Convex, Inc.",
  "license": "MIT",
  "devDependencies": {
    "tsx": "^4.19.4",
    "shx": "~0.4.0",
    "vitest": "^4.1.0",
    "@types/node": "^18.17.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "esbuild": "0.27.0"
  },
  "dependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}
