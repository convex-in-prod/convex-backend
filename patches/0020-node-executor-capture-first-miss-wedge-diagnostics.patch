+#[cfg(not(target_os = "linux"))]
+async fn read_thread_stats(
+    _pid: u32,
+    _expected_start_time_ticks: u64,
+) -> anyhow::Result<Option<(Vec<ThreadStatSnapshot>, bool)>> {
+    Ok(None)
+}
