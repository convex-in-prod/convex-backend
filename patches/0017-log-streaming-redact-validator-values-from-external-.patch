+    fn redacts_validation_values_from_exception_formats() -> anyhow::Result<()> {
+        let cases = [
+            (
+                "ArgumentValidationError: Object is missing a field.\n\nObject: {name: \
+                 \"sensitive-name\"}\nValidator: v.object({})",
+                REDACTED_ARGUMENT_VALIDATION_ERROR,
