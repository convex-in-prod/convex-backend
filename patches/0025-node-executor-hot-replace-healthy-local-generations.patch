+    let result = unsafe { libc::kill(pid, libc::SIGUSR2) };
+    if result == 0 {
+        FirstMissDiagnosticOutcome::DiagnosticReportRequested
+    } else {
+        FirstMissDiagnosticOutcome::DiagnosticReportRequestFailed
+    }
