+fn trigger_node_diagnostic_report(pid: u32) -> FirstMissDiagnosticOutcome {
+    if pid == 0 {
+        return FirstMissDiagnosticOutcome::DiagnosticReportInvalidPid;
+    }
+    let Ok(pid) = i32::try_from(pid) else {
+        return FirstMissDiagnosticOutcome::DiagnosticReportInvalidPid;
