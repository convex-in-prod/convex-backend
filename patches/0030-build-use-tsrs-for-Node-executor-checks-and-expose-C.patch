index 0000000000000000000000000000000000000000..d58b87796e321a3da192cd0f88ee2f3caa9eae6d
--- /dev/null
+++ b/npm-packages/convex/src/cli/lib/typecheck.test.ts
@@ -0,0 +1,128 @@
+import { mkdirSync, realpathSync, writeFileSync } from "node:fs";
+import path from "node:path";
+import { expect, test, vi } from "vitest";
+import type { Context } from "../../bundler/context.js";
+import { nodeFs, RecordingFs, withTmpDir } from "../../bundler/fs.js";
+import { parseProjectConfig } from "./config.js";
+import {
+  findTypeScriptCompilerPath,
+  resolveTypescriptCompiler,
+  typeCheckFunctions,
+  typeCheckFunctionsInMode,
+} from "./typecheck.js";
+
+function testContext(): Context {
+  return {
+    fs: nodeFs,
+    deprecationMessagePrinted: false,
+    crash: async ({ printedMessage }) => {
+      throw new Error(printedMessage ?? "CLI crashed without a message");
+    },
+    registerCleanup: () => "test-cleanup",
+    removeCleanup: () => async () => {},
+    bigBrainAuth: () => null,
+    _updateBigBrainAuth: () => {},
+  };
+}
+
+test("project configuration accepts tsrs and rejects unknown compilers", async () => {
+  expect(
+    await parseProjectConfig(testContext(), { typescriptCompiler: "tsrs" }),
+  ).toMatchObject({ typescriptCompiler: "tsrs" });
+  await expect(
+    parseProjectConfig(testContext(), { typescriptCompiler: "other" }),
+  ).rejects.toThrow();
+});
+
+test("an explicitly selected tsrs does not fall back to an installed tsc", () => {
+  const tsc = path.join("node_modules", "typescript", "bin", "tsc");
+  const tsrs = path.join("node_modules", "tsrs", "bin", "tsrs");
+  expect(
+    findTypeScriptCompilerPath({ exists: (p) => p === tsc }, "tsrs"),
+  ).toBeUndefined();
+  expect(
+    findTypeScriptCompilerPath(
+      { exists: (p) => p === tsc || p === tsrs },
+      "tsrs",
+    ),
+  ).toBe(tsrs);
+});
+
+test("tsrs launcher retains file observation and diagnostic retry behavior", async () => {
+  await withTmpDir(async (tmpDir) => {
+    const originalDirectory = process.cwd();
+    const recordingFs = new RecordingFs(false);
+    const registerPath = vi.spyOn(recordingFs, "registerPath");
+    // The child resolves cwd to its real path, including macOS's symlinked temp directory.
+    const sourcePath = path.join(
+      realpathSync(tmpDir.path),
+      "convex",
+      "check.ts",
+    );
+    mkdirSync(path.join(tmpDir.path, "convex"));
+    mkdirSync(path.join(tmpDir.path, "node_modules", "tsrs", "bin"), {
+      recursive: true,
+    });
+    writeFileSync(
+      path.join(tmpDir.path, "convex.json"),
+      JSON.stringify({ typescriptCompiler: "tsrs" }),
+    );
+    writeFileSync(path.join(tmpDir.path, "convex", "tsconfig.json"), "{}");
+    writeFileSync(sourcePath, "valid");
+    // A package launcher fixture exercises the child-process protocol without installing a
+    // platform-specific compiler. The source controls whether both diagnostic passes fail.
+    writeFileSync(
+      path.join(tmpDir.path, "node_modules", "tsrs", "bin", "tsrs"),
+      `const fs = require("node:fs");
+const path = require("node:path");
+if (process.argv.includes("--version")) {
+  console.log("Version 7.1.0-dev.20260930.4 (tsrs 0.18.0-ts7.1.0-dev.20260929, microsoft/TypeScript@b85298b6a81f)");
+} else {
+  const source = path.resolve("convex/check.ts");
+  if (process.argv.includes("--listFiles")) console.log(source);
+  if (fs.readFileSync(source, "utf8") === "invalid") {
+    console.log("check.ts: error TS2322: fixture type error");
+    process.exitCode = 1;
+  }
+}
+`,
+    );
+    try {
+      process.chdir(tmpDir.path);
+      const ctx = testContext();
+      ctx.fs = recordingFs;
+      expect(await resolveTypescriptCompiler(ctx)).toBe("tsrs");
+      expect(await resolveTypescriptCompiler(ctx, "tsc")).toBe("tsc");
+      await typeCheckFunctionsInMode(ctx, "enable", "convex");
+      expect(registerPath.mock.calls.some(([p]) => p === sourcePath)).toBe(
+        true,
+      );
+      expect(recordingFs.finalize()).not.toBe("invalidated");
+
+      writeFileSync(sourcePath, "invalid");
+      const retryFs = new RecordingFs(false);
+      ctx.fs = retryFs;
+      let failed = false;
+      await typeCheckFunctions(
+        ctx,
+        "tsrs",
+        "convex",
+        async (result, _log, retry) => {
+          expect(result).toBe("typecheckFailed");
+          expect(retry).toBeDefined();
+          await expect(retry!()).rejects.toMatchObject({ status: 1 });
+          expect(retryFs.finalize()).not.toBe("invalidated");
+          // A corrected source between passes retains the existing concurrent-change recovery.
+          writeFileSync(sourcePath, "valid");
+          await expect(retry!()).resolves.toBe("success");
+          failed = true;
+        },
+      );
+      expect(failed).toBe(true);
+      expect(retryFs.finalize()).toBe("invalidated");
+    } finally {
+      process.chdir(originalDirectory);
+      registerPath.mockRestore();
+    }
+  });
+});
