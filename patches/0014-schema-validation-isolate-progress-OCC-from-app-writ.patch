+                // retention removes them. Their inactive progress tables are
+                // already owned by tablet cleanup and cannot be queried here.
+                if !tx
+                    .table_mapping()
+                    .namespace(namespace)
+                    .name_exists(&SCHEMA_VALIDATION_PROGRESS_TABLE)
+                {
