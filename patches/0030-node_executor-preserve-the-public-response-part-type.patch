From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Roman Leventov <leventov.ru@gmail.com>
Date: Thu, 10 Sep 2026 04:29:53 +0800
Subject: [PATCH 30/30] node_executor: preserve the public response part type

Restore ResponsePart visibility and the crate-root export retained by upstream. Stream consumers must be able to name the public response representation after the completion-handling changes.
---
 crates/node_executor/src/executor.rs | 2 +-
 crates/node_executor/src/lib.rs      | 1 +
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/crates/node_executor/src/executor.rs b/crates/node_executor/src/executor.rs
index 28f8db2726cf5b177a40b609f7a9cb31071f3a58..a58ae8d583ecce9ff14be3641f05097f349a6b86 100644
--- a/crates/node_executor/src/executor.rs
+++ b/crates/node_executor/src/executor.rs
@@ -1203,7 +1203,7 @@ impl From<VisibilityJson> for Visibility {
     }
 }
 
-enum ResponsePart {
+pub enum ResponsePart {
     LogLine(LogLine),
     Result(JsonValue),
 }
diff --git a/crates/node_executor/src/lib.rs b/crates/node_executor/src/lib.rs
index 96faf1a65b00fa7676efcc5cafc75f45ed27230e..fa8b3c561158b05ea6dab4ed43f21d6ff73588e5 100644
--- a/crates/node_executor/src/lib.rs
+++ b/crates/node_executor/src/lib.rs
@@ -30,6 +30,7 @@ pub use crate::executor::{
     NodeExecutorCutoverTarget,
     NodeExecutorStreamPart,
     Package,
+    ResponsePart,
     SourcePackage,
     ARGS_TOO_LARGE_RESPONSE_MESSAGE,
     EXECUTE_TIMEOUT_RESPONSE_JSON,
