From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Roman Leventov <leventov.ru@gmail.com>
Date: Thu, 10 Sep 2026 03:46:26 +0800
Subject: [PATCH 28/30] node_executor: restore public stream processing exports

Keep the upstream stream parser and part type available to external crate consumers after the downstream bounded-response adaptation. Exercise explicit and inferred completion failures, truncated tails, and duplicate results through the public API.
---
 crates/node_executor/src/lib.rs               |  2 +
 .../node_executor/tests/stream_completion.rs  | 58 +++++++++++++++++++
 2 files changed, 60 insertions(+)
 create mode 100644 crates/node_executor/tests/stream_completion.rs

diff --git a/crates/node_executor/src/lib.rs b/crates/node_executor/src/lib.rs
index 94e331072230bddb5f7ea8a80571185e9c9ff3fa..96faf1a65b00fa7676efcc5cafc75f45ed27230e 100644
--- a/crates/node_executor/src/lib.rs
+++ b/crates/node_executor/src/lib.rs
@@ -15,6 +15,7 @@ pub mod source_package;
 
 pub use crate::executor::{
     error_response_json,
+    handle_node_executor_stream,
     AnalyzeRequest,
     AnalyzeResponse,
     BuildDepsRequest,
@@ -27,6 +28,7 @@ pub use crate::executor::{
     NodeExecutor,
     NodeExecutorCutoverReservation,
     NodeExecutorCutoverTarget,
+    NodeExecutorStreamPart,
     Package,
     SourcePackage,
     ARGS_TOO_LARGE_RESPONSE_MESSAGE,
diff --git a/crates/node_executor/tests/stream_completion.rs b/crates/node_executor/tests/stream_completion.rs
new file mode 100644
index 0000000000000000000000000000000000000000..e32d8d39002463e54b41123de17fb86116b10284
--- /dev/null
+++ b/crates/node_executor/tests/stream_completion.rs
@@ -0,0 +1,58 @@
+use bytes::Bytes;
+use node_executor::{
+    handle_node_executor_stream,
+    InvokeCompletion,
+    InvokeResponse,
+    NodeExecutorStreamPart,
+};
+use serde_json::json;
+use tokio::sync::mpsc;
+
+#[tokio::test]
+async fn public_stream_api_preserves_completion_authority() {
+    for explicit in [false, true] {
+        let failure = InvokeResponse {
+            response: json!({ "type": "error" }),
+            aws_request_id: None,
+        };
+        let completion = if explicit {
+            InvokeCompletion::ExplicitError(failure)
+        } else {
+            InvokeCompletion::ImplicitError(failure)
+        };
+        let (sender, _receiver) = mpsc::unbounded_channel();
+        let stream = futures::stream::iter([
+            Ok(NodeExecutorStreamPart::Chunk(Bytes::from_static(
+                b"{\"type\":\"success\"}\n{\"crash\":\"\xff",
+            ))),
+            Ok(NodeExecutorStreamPart::InvokeComplete(completion)),
+        ]);
+        match handle_node_executor_stream(sender, stream).await.unwrap() {
+            Ok(result) => {
+                assert!(!explicit);
+                assert_eq!(result, json!({ "type": "success" }));
+            },
+            Err(failure) => {
+                assert!(explicit);
+                assert_eq!(failure.response, json!({ "type": "error" }));
+            },
+        }
+    }
+}
+
+#[tokio::test]
+async fn public_stream_api_rejects_duplicate_results_with_inferred_failure() {
+    let (sender, _receiver) = mpsc::unbounded_channel();
+    let stream = futures::stream::iter([
+        Ok(NodeExecutorStreamPart::Chunk(Bytes::from_static(
+            b"{\"type\":\"success\"}\n{\"type\":\"success\"}",
+        ))),
+        Ok(NodeExecutorStreamPart::InvokeComplete(
+            InvokeCompletion::ImplicitError(InvokeResponse {
+                response: json!({ "type": "error" }),
+                aws_request_id: None,
+            }),
+        )),
+    ]);
+    assert!(handle_node_executor_stream(sender, stream).await.is_err());
+}
