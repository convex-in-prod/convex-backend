+    fn spawn_watchdog(&self, inner: &Arc<InnerLocalNodeExecutor>) {
+        Self::spawn_watchdog_state(
+            &self.state,
+            inner,
+            self.config.clone(),
+            self.transition_changed.clone(),
+            self.shutting_down.clone(),
