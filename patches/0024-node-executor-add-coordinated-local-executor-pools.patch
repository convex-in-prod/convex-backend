+    fn record_child_exit(pool_name: &str, status: ExitStatus) -> &'static str {
+        let exit_class = if status.success() {
+            "success"
+        } else if status.code().is_some() {
+            "failure"
+        } else {
+            "signal"
+        };
+        crate::metrics::log_local_node_child_exit(pool_name, exit_class);
+        exit_class
+    }
