From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Roman Leventov <leventov.ru@gmail.com>
Date: Thu, 10 Sep 2026 03:53:25 +0800
Subject: [PATCH 29/30] mysql: adapt deployment deletion pool to cancellation
 ownership

Pass the required runtime to the downstream pool constructor from the new upstream deployment-deletion caller. Use transport-only cancellation because a cluster URL does not establish that data and control connections share one numeric connection-ID namespace.
---
 crates/mysql/src/v5/deployment_deletion.rs | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/crates/mysql/src/v5/deployment_deletion.rs b/crates/mysql/src/v5/deployment_deletion.rs
index d2f4ae1fcc3c588ff46fe0a64cd530cd1a0a77d6..481db1c201a985f4d51967fe6ba54e3efe60713a 100644
--- a/crates/mysql/src/v5/deployment_deletion.rs
+++ b/crates/mysql/src/v5/deployment_deletion.rs
@@ -24,6 +24,7 @@ use url::Url;
 use crate::{
     connection::MySqlConnection,
     ConvexMySqlPool,
+    MySqlConnectionIdTopology,
     MySqlInstanceName,
 };
 
@@ -155,7 +156,10 @@ impl<RT: Runtime> DeploymentDeletionPool<RT> {
             &url,
             *DATABASE_USE_PREPARED_STATEMENTS,
             true, /* require_leader */
-            Some(runtime),
+            runtime,
+            // A cluster URL alone does not establish a shared server connection-ID
+            // namespace. Cancellation must only close this client's transport.
+            MySqlConnectionIdTopology::Untrusted,
         )?);
         Ok(Self { pool, db_name })
     }
