+
+#[derive(Default)]
+struct MutationApi {
+    calls: Mutex<BTreeMap<u32, bool>>,
+    action_calls: Mutex<Vec<bool>>,
+}
+
+impl MutationApi {
+    fn execute_action(
+        &self,
+        admin: bool,
+    ) -> anyhow::Result<Result<RedactedActionReturn, RedactedActionError>> {
+        let mut calls = self.action_calls.lock().unwrap();
+        calls.push(admin);
+        let code = match calls.len() {
+            1 => "ExpiredInQueue",
+            2 => "ExecuteFullError",
+            3 => "InitialPermitTimeoutError",
+            4 => "IsolateNotClean",
+            5 => {
+                return Err(ErrorMetadata::rate_limited(
+                    "TooManyConcurrentRequests",
+                    "private diagnostic",
+                )
+                .into())
+            },
+            6 => {
+                return Ok(Ok(RedactedActionReturn {
+                    value: JsonPackedValue::pack(common::value::ConvexValue::Int64(8)),
+                    log_lines: RedactedLogLines::empty(),
+                }))
+            },
+            _ => panic!("worker resubmitted an action"),
+        };
+        Err(ErrorMetadata::rejected_before_execution(code, "private diagnostic").into())
+    }
+
+    fn execute(
+        &self,
+        identifier: Option<SessionRequestIdentifier>,
+        admin: bool,
+    ) -> anyhow::Result<Result<RedactedMutationReturn, RedactedMutationError>> {
+        let identifier = identifier.expect("worker omitted mutation identity");
+        assert_eq!(
+            identifier.session_id,
+            "00000000-0000-0000-0000-000000000000"
+                .parse::<SessionId>()
+                .unwrap()
+        );
+        assert!(
+            self.calls
+                .lock()
+                .unwrap()
+                .insert(identifier.request_id, admin)
+                .is_none(),
+            "worker resubmitted a terminal mutation"
+        );
+        match identifier.request_id {
+            0 => Err(ErrorMetadata::system_occ(None, Some("private diagnostic".into())).into()),
+            1 => Err(ErrorMetadata::user_occ(None, Some("private diagnostic".into()), None).into()),
+            2 => Ok(Ok(RedactedMutationReturn {
+                value: JsonPackedValue::pack(common::value::ConvexValue::Int64(7)),
+                ts: Timestamp::MIN,
+                log_lines: RedactedLogLines::empty(),
+            })),
+            _ => panic!("unexpected mutation identity"),
+        }
+    }
+}
