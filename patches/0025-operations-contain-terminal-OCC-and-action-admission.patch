+#[test]
+fn operation_failures_keep_public_and_admin_requests_on_one_worker() -> anyhow::Result<()> {
+    let tokio = ProdRuntime::init_tokio()?;
+    let rt = ProdRuntime::new(&tokio);
+    let worker_rt = rt.clone();
+    rt.block_on("sync_terminal_occ", async move {
+        tokio::time::timeout(Duration::from_secs(10), async move {
+            for admin in [false, true] {
+                let api = Arc::new(MutationApi::default());
+                let (client_tx, client_rx) = mpsc::unbounded_channel();
+                let (server_tx, mut server_rx) = measurable_unbounded_channel();
+                let connected = Arc::new(AtomicUsize::new(0));
+                let on_connect = connected.clone();
+                let mut worker = SyncWorker::new(
+                    api.clone(),
+                    worker_rt.clone(),
+                    ResolvedHostname {
+                        deployment_name: String::new(),
+                        destination: RequestDestination::ConvexCloud,
+                        source: ResolvedHostnameSource::Local,
+                    },
+                    SyncWorkerConfig::default(),
+                    client_rx,
+                    server_tx,
+                    Box::new(move |_| {
+                        on_connect.fetch_add(1, Ordering::SeqCst);
+                    }),
+                    0,
+                    RequestMetadata::system(),
+                );
+                // At the exact per-connection limit, reject only the new action
+                // without growing the pending set or invoking the application.
+                for _ in 0..OPERATION_QUEUE_BUFFER_SIZE {
+                    worker
+                        .action_futures
+                        .push(futures::future::pending().boxed());
+                }
+                worker
+                    .handle_message(ClientMessage::Action {
+                        request_id: 99,
+                        udf_path: "fixture:action".parse()?,
+                        args: SerializedArgs::from_args(vec![])?,
+                        component_path: None,
+                    })
+                    .await?;
+                assert_eq!(worker.action_futures.len(), OPERATION_QUEUE_BUFFER_SIZE);
+                assert!(api.action_calls.lock().unwrap().is_empty());
+                assert!(matches!(
+                    server_rx.next().await.unwrap().0,
+                    ServerMessage::ActionResponse {
+                        request_id: 99,
+                        result: Err(_),
+                        ..
+                    }
+                ));
+                worker.action_futures.clear();
+                let peer = async {
+                    client_tx.send((
+                        ClientMessage::Connect {
+                            session_id: "00000000-0000-0000-0000-000000000000".parse()?,
+                            connection_count: 0,
+                            last_close_reason: "InitialConnect".to_owned(),
+                            max_observed_timestamp: None,
+                            client_ts: None,
+                            query_workload_class: None,
+                            degradable_query_pressure_version: None,
+                        },
+                        worker_rt.monotonic_now(),
+                    ))?;
+                    if admin {
+                        client_tx.send((
+                            ClientMessage::Authenticate {
+                                base_version: 0.into(),
+                                token: AuthenticationToken::Admin("fixture".into(), None),
+                            },
+                            worker_rt.monotonic_now(),
+                        ))?;
+                    }
+                    for request_id in 10..16 {
+                        client_tx.send((
+                            ClientMessage::Action {
+                                request_id,
+                                udf_path: "fixture:action".parse()?,
+                                args: SerializedArgs::from_args(vec![])?,
+                                component_path: admin.then(String::new),
+                            },
+                            worker_rt.monotonic_now(),
+                        ))?;
+                        loop {
+                            let (message, _) = server_rx
+                                .next()
+                                .await
+                                .context("worker closed on action admission failure")?;
+                            match message {
+                                ServerMessage::ActionResponse {
+                                    request_id: response_id,
+                                    result,
+                                    log_lines,
+                                } => {
+                                    assert_eq!(response_id, request_id);
+                                    assert!(log_lines.0.is_empty());
+                                    if request_id < 15 {
+                                        let Err(ErrorPayload::Message(message)) = result else {
+                                            panic!(
+                                                "admission failure did not become an action \
+                                                 response"
+                                            );
+                                        };
+                                        assert_eq!(
+                                            message,
+                                            "Action admission failed: insufficient execution \
+                                             capacity. Try again later."
+                                        );
+                                    } else {
+                                        assert!(result.is_ok(), "following action failed");
+                                    }
+                                    break;
+                                },
+                                ServerMessage::Transition { .. } | ServerMessage::Ping => {},
+                                other => panic!("unexpected worker response: {other:?}"),
+                            }
+                        }
+                    }
+                    for request_id in 0..3 {
+                        client_tx.send((
+                            ClientMessage::Mutation {
+                                request_id,
+                                udf_path: "fixture:write".parse()?,
+                                args: SerializedArgs::from_args(vec![serde_json::json!({})])?,
+                                component_path: admin.then(String::new),
+                            },
+                            worker_rt.monotonic_now(),
+                        ))?;
+                    }
+                    let mut responses = Vec::new();
+                    while responses.len() < 3 {
+                        let (message, _) =
+                            server_rx.next().await.context("worker closed on OCC")?;
+                        match message {
+                            ServerMessage::MutationResponse {
+                                request_id,
+                                result,
+                                ts,
+                                log_lines,
+                            } => {
+                                assert_eq!(request_id as usize, responses.len());
+                                assert!(log_lines.0.is_empty());
+                                if request_id < 2 {
+                                    assert_eq!(ts, None);
+                                    let Err(ErrorPayload::Message(message)) = result else {
+                                        panic!("exhausted OCC did not become a terminal error");
+                                    };
+                                    assert_eq!(
+                                        message,
+                                        format!("{}: {}", errors::OCC_ERROR, errors::OCC_ERROR_MSG)
+                                    );
+                                } else {
+                                    assert!(result.is_ok(), "following mutation failed");
+                                    assert_eq!(ts, Some(Timestamp::MIN));
+                                }
+                                responses.push(request_id);
+                            },
+                            ServerMessage::Transition { .. } | ServerMessage::Ping => {},
+                            other => panic!("unexpected worker response: {other:?}"),
+                        }
+                    }
+                    // A query-set change after both rejections still reaches the same worker.
+                    client_tx.send((
+                        ClientMessage::ModifyQuerySet {
+                            base_version: 0.into(),
+                            new_version: 1.into(),
+                            modifications: vec![],
+                        },
+                        worker_rt.monotonic_now(),
+                    ))?;
+                    loop {
+                        let (message, _) = server_rx
+                            .next()
+                            .await
+                            .context("worker stopped after mutation")?;
+                        match message {
+                            ServerMessage::Transition { end_version, .. }
+                                if end_version.query_set == 1.into() =>
+                            {
+                                break
+                            },
+                            ServerMessage::Transition { .. } | ServerMessage::Ping => {},
+                            other => panic!("unexpected extra response: {other:?}"),
+                        }
+                    }
+                    assert_eq!(
+                        api.calls.lock().unwrap().clone(),
+                        BTreeMap::from([(0, admin), (1, admin), (2, admin)])
+                    );
+                    assert_eq!(*api.action_calls.lock().unwrap(), vec![admin; 6]);
+                    assert_eq!(connected.load(Ordering::SeqCst), 1);
+                    drop(client_tx);
+                    Ok::<_, anyhow::Error>(())
+                };
+                futures::try_join!(worker.go(), peer)?;
+            }
+            Ok::<_, anyhow::Error>(())
+        })
+        .await?
+    })
+}
