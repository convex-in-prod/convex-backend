+    let has_more = route_keys.len().saturating_sub(start) > limit;
+    let page_route_keys = route_keys
+        .into_iter()
+        .skip(start)
+        .take(limit)
+        .collect::<Vec<_>>();
+    let next_cursor = has_more.then(|| {
