+fn assert_generated_normalize_id_accounting(output: &GeneratedExecutionOutput<ProdRuntime>) {
+    assert_eq!(output.invocation.read_accounting.documents, 0);
+    assert_eq!(output.invocation.read_accounting.bytes, 0);
+    assert_eq!(output.invocation.read_accounting.intervals, 0);
+    assert_eq!(
+        output
+            .invocation
+            .transaction
+            .execution_size()
+            .write_size
+            .num_writes,
+        0
+    );
+    assert_eq!(
+        output
+            .invocation
+            .transaction
+            .execution_size()
+            .write_size
+            .size,
+        0
+    );
+    assert_eq!(
+        output
+            .invocation
+            .transaction
+            .execution_size()
+            .scheduled_size
+            .num_writes,
+        0
+    );
+    assert_eq!(
+        output
+            .invocation
+            .transaction
+            .execution_size()
+            .scheduled_size
+            .size,
+        0
+    );
