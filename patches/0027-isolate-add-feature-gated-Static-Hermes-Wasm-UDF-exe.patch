+        .filter(|flag| flag.as_str() != "-typed")
+        .cloned()
+        .collect::<Vec<_>>();
+    if application_flags.len() != flags.len().saturating_sub(1) {
+        return Err(invalid_provenance(
+            "capability application Static Hermes flags require exactly one typed marker",
