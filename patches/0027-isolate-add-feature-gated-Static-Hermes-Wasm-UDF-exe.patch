+    pub(crate) fn finish(self, terminal: TerminalMemoryOutcome, retain_slot: bool) {
+        assert!(
+            !self.account.finished.swap(true, Ordering::AcqRel),
+            "generated Wasm memory permit completed more than once"
+        );
