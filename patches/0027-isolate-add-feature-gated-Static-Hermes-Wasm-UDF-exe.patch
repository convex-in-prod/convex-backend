+        let mut metrics = metric_store(base_ts, Duration::from_secs(60), 2);
+        let route_a = query_shadow_route_key('1', 'a');
+        let route_b = query_shadow_route_key('1', 'b');
+        for millis in 1u64..=100 {
+            let report = QueryShadowReport::new(
