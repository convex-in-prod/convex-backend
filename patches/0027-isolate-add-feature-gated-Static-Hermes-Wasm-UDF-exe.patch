+fn validate_split_schema_3_selector_provenance(
+    selector: &JsonValue,
+    application_unit: &CapabilityApplicationUnitProvenance,
+    core_wasm: &CapabilitySplitCoreWasmIdentity,
+    routes: &[CapabilityEntryRoute],
