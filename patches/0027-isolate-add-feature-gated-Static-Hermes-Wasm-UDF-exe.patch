+                QueryShadowInsertedDocumentIdentity::NotApplicable
+                | QueryShadowInsertedDocumentIdentity::NotRequired
+                | QueryShadowInsertedDocumentIdentity::Matched => true,
+                QueryShadowInsertedDocumentIdentity::Inconsistent
