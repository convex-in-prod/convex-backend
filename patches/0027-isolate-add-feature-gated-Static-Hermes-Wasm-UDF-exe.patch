+fn read_accounting(size: &FunctionExecutionSize) -> ReadAccounting {
+    ReadAccounting {
+        documents: size.read_size.total_document_count,
+        bytes: size.read_size.total_document_size,
+        intervals: size.num_intervals,
+    }
