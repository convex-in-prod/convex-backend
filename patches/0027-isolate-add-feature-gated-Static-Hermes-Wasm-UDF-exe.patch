+            || self.bucket >= self.partition_policy.bucket_count
+        {
+            return Err(invalid(
+                "artifact.cohort.partitionPolicy",
+                "unsupported cohort partition policy or bucket",
+            ));
+        }
+        Ok(())
+    }
