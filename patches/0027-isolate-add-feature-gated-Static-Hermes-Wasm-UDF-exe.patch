+            })
+        })
+        .collect::<anyhow::Result<Vec<_>>>()?;
+
+    Ok(QueryShadowEvidencePage {
+        udf_type,
+        direction,
+        aggregate,
+        selection: Some(selection),
+        routes,
+        next_cursor,
+    })
