+        Ok(value) if value == "1" => Some(true),
+        Ok(_) => panic!("Invalid value for {name}: expected 0 or 1"),
+        Err(std::env::VarError::NotPresent) => None,
+        Err(std::env::VarError::NotUnicode(..)) => {
