+                "getMessage",
+                vec![JsonValue::String(id.clone())],
+                &artifact,
+            )
+            .await?;
+            let query_result = outcome_result(query_outcome)?;
+            assert_eq!(query_result["_id"], id);
+            assert_eq!(query_result["body"], "hello");
+            Ok(())
+        },
+    )
+}
