+        let mut exports = EncodedExportSection::new();
+        exports.export("memory", EncodedExportKind::Memory, 0);
+        exports.export(
+            "_initialize",
+            EncodedExportKind::Func,
+            imported_function_count,
+        );
+        exports.export(
+            "convex_wasm_udf_run",
+            EncodedExportKind::Func,
+            imported_function_count + 1,
