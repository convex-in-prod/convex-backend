+    for expected_handle in [first, second] {
+        let (handle, mut continuation) = queue.pop_pending().context("query disappeared")?;
+        assert_eq!(handle, expected_handle);
+        continuation.remaining_values -= 1;
+        continuation.observed_values += 1;
