+        let artifact = manifest["artifact"]
+            .as_object_mut()
+            .context("generated cohort test artifact must be an object")?;
+        artifact.remove("provenanceBytes");
+        artifact.remove("provenanceSha256");
+        artifact.insert(
+            "cohort".to_owned(),
