+                            value,
+                            fixture_ids,
+                            referenced_aliases,
+                        )?,
+                    ))
+                })
+                .collect::<anyhow::Result<serde_json::Map<_, _>>>()?,
+        )),
+        JsonValue::Null | JsonValue::Bool(_) | JsonValue::Number(_) | JsonValue::String(_) => {
