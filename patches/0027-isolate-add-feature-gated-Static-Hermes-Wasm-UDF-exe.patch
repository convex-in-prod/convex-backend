+
+impl InvocationCapabilityIdentity {
+    pub(super) fn from_abi(value: i64) -> Result<Self, CapabilityBridgeError> {
+        NonZeroU64::new(value as u64)
+            .map(Self)
+            .ok_or(CapabilityBridgeError::ForgedIdentity)
