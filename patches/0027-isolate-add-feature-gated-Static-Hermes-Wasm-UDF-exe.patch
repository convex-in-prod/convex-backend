+fn take_generated_routed_instance_locked<RT: Runtime>(
+    pool: &mut GeneratedRoutedInstancePool,
+    routed: &GeneratedRoutedModule,
+    reuse_instances: bool,
+) -> Option<GeneratedReusableInstance<RT>> {
+    if !reuse_instances {
+        return None;
