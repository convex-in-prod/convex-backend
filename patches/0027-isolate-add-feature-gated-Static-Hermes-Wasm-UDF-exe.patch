+pub(super) fn read_guest_bytes<RT: Runtime>(
+    caller: &mut Caller<'_, HostState<RT>>,
+    pointer: i32,
+    length: i32,
+    maximum: usize,
+) -> Result<Vec<u8>, WasmtimeError> {
+    let length = checked_len(length, maximum)?;
+    let mut bytes = vec![0; length];
+    guest_memory(caller)?
+        .read(caller, checked_offset(pointer)?, &mut bytes)
+        .map_err(WasmtimeError::from)?;
+    Ok(bytes)
+}
