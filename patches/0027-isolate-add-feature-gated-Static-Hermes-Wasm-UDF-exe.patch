+            "targetCpu": GENERATED_TARGET_CPU,
+            "engineConfigurationSha256": GENERATED_ENGINE_CONFIGURATION_SHA256,
+            "engineCompatibilitySha256": GENERATED_ENGINE_COMPATIBILITY_SHA256,
+            "coreWasmBytes": 1,
