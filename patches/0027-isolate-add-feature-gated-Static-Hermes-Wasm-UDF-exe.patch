+    pub(crate) fn limiter(&self, store_limits: StoreLimits) -> GeneratedStoreLimiter {
+        GeneratedStoreLimiter {
+            store_limits,
+            account: Arc::clone(&self.account),
+            pending_growth: None,
+        }
+    }
