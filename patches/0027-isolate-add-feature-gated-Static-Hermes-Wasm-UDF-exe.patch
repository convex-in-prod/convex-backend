+pub(super) fn validate_guest_value_decode_imports(
+    convex_imports: &BTreeSet<String>,
+) -> anyhow::Result<()> {
+    let imports_opaque_decode = convex_imports.contains("convex_guest_value_decode");
+    let imports_owned_payload = [
