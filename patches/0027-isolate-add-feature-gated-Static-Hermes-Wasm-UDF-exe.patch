+#[derive(Clone)]
+struct GeneratedGraphGotBinding {
+    global: Global,
+    provider: String,
+    provider_export: Option<String>,
+    weak: bool,
+}
+
+type GeneratedGraphGotBindings = BTreeMap<(String, String), GeneratedGraphGotBinding>;
