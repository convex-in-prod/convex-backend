+    #[cfg(test)]
+    pub(crate) fn contains_existing_runtime_action(
+        &self,
+        runtime_module_path: &str,
+        export_name: &str,
+    ) -> bool {
+        self.existing_runtime_actions
+            .contains(&DeploymentExportKey::new(runtime_module_path, export_name))
