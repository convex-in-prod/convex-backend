+    function.instruction(&EncodedInstruction::GlobalGet(table_index_global));
+    function.instruction(&EncodedInstruction::CallIndirect {
+        type_index: 0,
+        table_index: 0,
+    });
+    function.instruction(&EncodedInstruction::I32Store(memory_word()));
