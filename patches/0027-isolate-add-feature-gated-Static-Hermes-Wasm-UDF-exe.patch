+fn assert_clean(output: &GeneratedExecutionOutput<ProdRuntime>) {
+    assert_eq!(output.invocation.opaque_live_handles, 0);
+    assert_eq!(output.invocation.opaque_current_bytes, 0);
+    assert!(!output.invocation.observed_rng);
+}
