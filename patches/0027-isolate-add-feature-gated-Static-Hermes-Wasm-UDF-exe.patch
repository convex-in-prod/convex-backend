+            AsyncSyscallResult::with_host_operation_error(
+                serde_json::value::to_raw_value(&value.to_uncommitted_json_serializable())
+                    .map_err(Into::into),
+                None,
+            )
+        },
+        Err(error) => {
+            AsyncSyscallResult::with_host_operation_error(Err(error), host_operation_error)
+        },
+    }
