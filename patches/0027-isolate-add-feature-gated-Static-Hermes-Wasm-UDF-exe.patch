+                "size": generation_bytes.len(),
+            },
+            "generationSha256": generation_sha256,
+            "kind": "convex-wasm-runtime-registry-current-v1",
+        });
+        let current_sha256 = sha256(&canonical_bytes(&current)?);
+        current
+            .as_object_mut()
