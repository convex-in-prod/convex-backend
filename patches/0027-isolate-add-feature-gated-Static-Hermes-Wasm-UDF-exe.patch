+    validate_directory_entries_exact(package_path, &CAPABILITY_ENTRY_PACKAGE_FILES)?;
+
+    let complete = read_bounded_file(&package_path.join("COMPLETE"), MAX_COMPLETE_MARKER_BYTES)?;
