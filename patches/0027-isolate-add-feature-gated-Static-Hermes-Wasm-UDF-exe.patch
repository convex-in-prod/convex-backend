+    GuestMemoryLimit,
+    #[error("Static Hermes Wasm guest execution failed")]
+    GuestExecution,
+    #[error("Static Hermes Wasm result finalization failed")]
+    ResultFinalization,
+    #[error("Static Hermes Wasm runtime cleanup failed")]
