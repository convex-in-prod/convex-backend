+struct RetirementBarrierTracker {
+    outstanding: AtomicUsize,
+}
+
+impl RetirementBarrierTracker {
+    fn new() -> Arc<Self> {
+        crate::metrics::set_local_node_outstanding_predecessor_retirement_barriers(0);
+        Arc::new(Self {
+            outstanding: AtomicUsize::new(0),
+        })
+    }
+
+    fn start(self: &Arc<Self>, pool_name: Arc<str>) -> RetirementBarrierGuard {
+        self.outstanding
+            .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |count| {
+                count.checked_add(1)
+            })
+            .expect("Local Node executor retirement barrier count overflow");
+        crate::metrics::increment_local_node_outstanding_predecessor_retirement_barriers();
+        RetirementBarrierGuard {
+            tracker: self.clone(),
+            pool_name,
+            published: false,
+        }
+    }
+
+    fn outstanding(&self) -> usize {
+        self.outstanding.load(Ordering::Relaxed)
+    }
+}
+
+struct RetirementBarrierGuard {
+    tracker: Arc<RetirementBarrierTracker>,
+    pool_name: Arc<str>,
+    published: bool,
+}
+
+impl RetirementBarrierGuard {
+    fn mark_published(&mut self) {
+        self.published = true;
+    }
+}
+
+impl Drop for RetirementBarrierGuard {
+    fn drop(&mut self) {
+        // Drop also covers an aborted or panicked runtime-owned retirement task,
+        // which otherwise closes the result channel without an explicit event.
+        if !self.published {
+            tracing::warn!(
+                pool_name = %self.pool_name,
+                lifecycle_context = "topology_retirement",
+                outcome = "canceled",
+                "Local Node executor predecessor-retirement barrier was canceled"
+            );
+        }
+        self.tracker
+            .outstanding
+            .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |count| {
+                count.checked_sub(1)
+            })
+            .expect("Local Node executor retirement barrier count underflow");
+        crate::metrics::decrement_local_node_outstanding_predecessor_retirement_barriers();
+    }
+}
