+            )
+            .unwrap();
+        let (default_replacement, named_replacement) = {
+            let state = executor.state.read().unwrap();
+            (
+                state.default.clone(),
+                state.named.get(&"named".parse().unwrap()).unwrap().clone(),
+            )
+        };
+        assert_eq!(default_replacement.predecessors.len(), 2);
+        assert_eq!(named_replacement.predecessors.len(), 2);
+        let waiting_default = default_replacement.clone();
+        let default_selection = tokio::spawn(async move { waiting_default.executor().await });
+        let waiting_named = named_replacement.clone();
+        let named_selection = tokio::spawn(async move { waiting_named.executor().await });
+
+        default_tx.send_replace(Some(Ok(())));
+        tokio::task::yield_now().await;
+        assert!(!default_selection.is_finished());
+        assert!(!named_selection.is_finished());
+        named_tx.send_replace(Some(Ok(())));
+        default_selection.await.unwrap().unwrap();
+        named_selection.await.unwrap().unwrap();
+    }
