+                Timestamp::try_from(1_u64).unwrap(),
+            )
+            .unwrap();
+        let new_pool = executor
+            .state
+            .read()
+            .unwrap()
+            .named
+            .get(&"new".parse().unwrap())
+            .unwrap()
+            .clone();
+        let waiting = tokio::spawn(async move { new_pool.wait_for_predecessor().await });
+        tokio::task::yield_now().await;
+        assert!(!waiting.is_finished());
+
+        retirement_tx.send_replace(Some(Ok(())));
+        waiting.await.unwrap().unwrap();
+    }
+
+    #[tokio::test]
+    async fn default_and_named_replacements_wait_for_each_other() {
+        let local = LocalNodeExecutor::preflight_configuration(
+            Duration::from_secs(1),
+            MemoryPressureSignal::default(),
+        )
+        .unwrap();
+        let executor =
+            RoutedLocalNodeExecutor::new_with_configuration(RoutedLocalNodeExecutorConfig {
+                local,
+                total_rss_budget_bytes: *LOCAL_NODE_EXECUTOR_MAX_RSS_BYTES * 2,
+            })
+            .await
+            .unwrap();
+        let (default_tx, default_rx) = watch::channel(None);
+        let (named_tx, named_rx) = watch::channel(None);
+        {
+            let mut state = executor.state.write().unwrap();
+            state.default = Arc::new(RoutedPool::new(
+                Arc::from("default"),
+                &executor.local_config,
+                vec![predecessor_barrier(&executor.local_config, default_rx)],
+            ));
+            state.named.insert(
+                "named".parse().unwrap(),
+                Arc::new(RoutedPool::new(
+                    Arc::from("named"),
+                    &executor.local_config,
+                    vec![predecessor_barrier(&executor.local_config, named_rx)],
+                )),
+            );
+            state.topology = NodeExecutorPoolTopology::new_complete(
