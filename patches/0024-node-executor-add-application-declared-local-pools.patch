+                local,
+                total_rss_budget_bytes: *LOCAL_NODE_EXECUTOR_MAX_RSS_BYTES * 2,
+            })
+            .await
+            .unwrap();
+        let (_result_tx, result_rx) = watch::channel(None);
+        let predecessor = predecessor_barrier(&executor.local_config, result_rx);
