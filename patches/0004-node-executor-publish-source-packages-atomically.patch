+    nameOffset = result.indexOf(encodedName, nameOffset + 1);
+    if (nameOffset === -1) {
+      throw new Error("Test ZIP central-directory entry is missing");
+    }
+    const centralHeaderOffset = nameOffset - 46;
+    if (
