     AnalyzeRequest,
     AnalyzeResponse,
     BuildDepsRequest,
@@ -27,7 +28,9 @@ pub use crate::executor::{
     NodeExecutor,
     NodeExecutorCutoverReservation,
     NodeExecutorCutoverTarget,
+    NodeExecutorStreamPart,
