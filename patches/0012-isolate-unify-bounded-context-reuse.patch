+        assert!(insertion.candidate_admitted);
+        assert_eq!(cache.len(), *MAX_REUSABLE_CONTEXTS_PER_ISOLATE);
+        assert!(cache.contains_key(&1));
+        assert!(!cache.contains_key(&2));
+    }
