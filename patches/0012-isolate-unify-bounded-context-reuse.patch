+        capacity > 0,
+        "ISOLATE_CONTEXT_CACHE_MAX_RESIDENTS must be greater than zero"
+    );
+    anyhow::ensure!(
+        capacity <= structural_capacity,
+        "ISOLATE_CONTEXT_CACHE_MAX_RESIDENTS must not exceed the structural capacity of \
+         {structural_capacity}"
+    );
+    Ok(capacity)
+}
