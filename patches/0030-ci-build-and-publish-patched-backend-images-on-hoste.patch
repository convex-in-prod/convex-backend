+# Ephemeral builders can reuse sccache in the final, feature-unified build
+# instead of cooking a second dependency graph into a non-exported target mount.
+case "$CARGO_CHEF_COOK" in
+  true)
+    PROTOC="$(mise which protoc)" cargo chef cook \
+      --profile "$CARGO_BUILD_PROFILE" \
+      --recipe-path recipe.json
+    ;;
+  false) ;;
+  *) echo "CARGO_CHEF_COOK must be true or false" >&2; exit 1 ;;
+esac
 EOF
