index 0000000000000000000000000000000000000000..e64ce675bc121076987e43ff5e8c5d71ad9bb6ea
--- /dev/null
+++ b/.github/workflows/build_patched_backend.yml
@@ -0,0 +1,177 @@
+name: Build patched backend image
+
+on:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+  packages: write
+
+# The registry cache is shared by manual builds of this patch train.
+concurrency:
+  group: patched-backend-image
+  cancel-in-progress: false
+
+jobs:
+  build:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 360
+    steps:
+      - name: Reclaim unused runner software
+        run: |
+          df -h / /var/lib/docker
+          df -i / /var/lib/docker
+          # Compilation happens inside Docker; these host SDKs are unused.
+          sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc \
+            /usr/local/.ghcup /usr/lib/jvm /usr/local/share/powershell \
+            /usr/share/swift /opt/hostedtoolcache
+          docker image prune --all --force
+          df -h / /var/lib/docker
+          df -i / /var/lib/docker
+
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
+
+      - name: Select image identity
+        run: |
+          image="ghcr.io/${GITHUB_REPOSITORY,,}"
+          {
+            echo "BACKEND_IMAGE=$image:sha-$GITHUB_SHA"
+            echo "BACKEND_CACHE=$image:buildcache-amd64"
+            echo "COMMIT_TIMESTAMP=$(git show -s --format=%cI HEAD)"
+          } >> "$GITHUB_ENV"
+
+      - name: Log in to GHCR
+        uses: docker/login-action@4907a6ddec9925e35a0a9e82d7399ccc52663121 # v4
+        with:
+          registry: ghcr.io
+          username: ${{ github.actor }}
+          password: ${{ secrets.GITHUB_TOKEN }}
+
+      - name: Set up bounded builder
+        id: builder
+        uses: docker/setup-buildx-action@bb05f3f5519dd87d3ba754cc423b652a5edd6d2c # v4
+        with:
+          driver-opts: |
+            memory=12g
+            memory-swap=12g
+            cpuset-cpus=0-3
+          buildkitd-config-inline: |
+            [worker.oci]
+              max-parallelism = 2
+              reservedSpace = "20GB"
+              maxUsedSpace = "60GB"
+              minFreeSpace = "6GB"
+
+      # Registry layer caches do not preserve RUN cache mounts. Export only
+      # bounded compiler output, not the much larger Cargo target directory.
+      - name: Restore compiler cache
+        uses: actions/cache@0057852bfaa89a56745cba8c7296529d2fc39830 # v4
+        with:
+          path: ${{ runner.temp }}/backend-sccache
+          key:
+            backend-sccache-amd64-v1-${{ hashFiles('rust-toolchain',
+            'self-hosted/docker-build/Dockerfile.backend') }}-${{ github.run_id
+            }}-${{ github.run_attempt }}
+          restore-keys: |
+            backend-sccache-amd64-v1-${{ hashFiles('rust-toolchain', 'self-hosted/docker-build/Dockerfile.backend') }}-
+
+      - name: Restore compiler cache mount
+        uses: reproducible-containers/buildkit-cache-dance@e475a9cbcb5052f85fd3830f1266fa0c91ef8595
+        with:
+          builder: ${{ steps.builder.outputs.name }}
+          scratch-dir: ${{ runner.temp }}/backend-cache-dance
+          cache-map: |
+            {
+              "${{ runner.temp }}/backend-sccache": {
+                "target": "/sccache",
+                "id": "convex-backend-sccache-amd64",
+                "sharing": "locked"
+              }
+            }
+
+      - name: Build and load image
+        timeout-minutes: 330
+        env:
+          BUILDER: ${{ steps.builder.outputs.name }}
+        run: |
+          # Report free disk during compilation, when the target mount is largest.
+          (while sleep 60; do date -u; df -h /var/lib/docker; df -i /var/lib/docker; done) &
+          monitor_pid=$!
+          trap 'kill "$monitor_pid"' EXIT
+          docker buildx build --builder "$BUILDER" --progress plain \
+            --platform linux/amd64 --load \
+            --file self-hosted/docker-build/Dockerfile.backend \
+            --tag "$BACKEND_IMAGE" \
+            --label "org.opencontainers.image.source=$GITHUB_SERVER_URL/$GITHUB_REPOSITORY" \
+            --label "io.convex.backend.allocator=jemalloc" \
+            --label "io.convex.backend.features=static-hermes-wasmtime-gate" \
+            --cache-from "type=registry,ref=$BACKEND_CACHE" \
+            --cache-to "type=registry,ref=$BACKEND_CACHE,mode=max" \
+            --build-arg "VERGEN_GIT_SHA=$GITHUB_SHA" \
+            --build-arg "VERGEN_GIT_COMMIT_TIMESTAMP=$COMMIT_TIMESTAMP" \
+            --build-arg CARGO_CHEF_COOK=false \
+            --build-arg CARGO_BUILD_JOBS=2 \
+            --build-arg NATIVE_PREBUILD_JOBS=2 \
+            --build-arg CARGO_PROFILE_RELEASE_DEBUG=0 \
+            --build-arg SERIALIZE_LOCAL_BACKEND_CODEGEN=true \
+            --build-arg SCCACHE_CACHE_SIZE=2G \
+            --build-arg LOCAL_BACKEND_FEATURES=static-hermes-wasmtime-gate \
+            --build-arg BUILD_SOURCE_PACKAGE_PREACTIVATION_AUTHORITY=true \
+            .
+
+      - name: Check runtime image
+        timeout-minutes: 5
+        run: |
+          docker run --rm --entrypoint /convex/convex-local-backend \
+            "$BACKEND_IMAGE" capabilities > "$RUNNER_TEMP/backend-capabilities.json"
+          jq -e '
+            .kind == "convex-local-backend-capabilities-v3" and
+            .staticHermesWasmtimeGate == true and .sourceKeyedPreparedPools == true and
+            ([.wasmRuntime.hostImports[] | select(.module == "convex") | .name] |
+              index("convex_async_operation_error_data_take_v1") != null and
+              index("convex_developer_error_data_v1") != null)
+          ' "$RUNNER_TEMP/backend-capabilities.json"
+          docker run --rm --entrypoint /bin/bash "$BACKEND_IMAGE" -euc '
+            test -x /convex/source_package_preactivation_authority
+            /convex/generate_key --help >/dev/null
+            node --version
+            npm --version
+          '
+          docker run --detach --name backend-smoke \
+            --publish 127.0.0.1:3210:3210 \
+            --env DISABLE_BEACON=true \
+            --env CONVEX_CLOUD_ORIGIN=http://127.0.0.1:3210 \
+            --env CONVEX_SITE_ORIGIN=http://127.0.0.1:3211 \
+            "$BACKEND_IMAGE"
+          trap 'docker logs backend-smoke; docker rm --force --volumes backend-smoke' EXIT
+          for _attempt in {1..60}; do
+            if curl --fail --silent --show-error --max-time 2 \
+              http://127.0.0.1:3210/version; then
+              exit 0
+            fi
+            test "$(docker inspect --format '{{.State.Running}}' backend-smoke)" = true
+            sleep 2
+          done
+          echo "Backend did not become ready" >&2
+          exit 1
+
+      - name: Publish tested image
+        run: |
+          docker push "$BACKEND_IMAGE"
+          digest=$(docker image inspect "$BACKEND_IMAGE" --format '{{index .RepoDigests 0}}')
+          {
+            echo "Image: \`$BACKEND_IMAGE\`"
+            echo ""
+            echo "Pull by digest: \`$digest\`"
+            echo ""
+            echo '```'
+            df -h /var/lib/docker
+            echo '```'
+          } >> "$GITHUB_STEP_SUMMARY"
+
+      - name: Report build storage
+        if: always()
+        run: |
+          df -h / /var/lib/docker
+          df -i / /var/lib/docker
+          docker system df
