+            );
+            assert_eq!(dispatched.recv().await, Some(3));
+
+            first_dependency.complete().await;
+            external.complete().await;
+            fresh_dependency.complete().await;
+            harness.shutdown().await;
+            assert_eq!(limiter.active_permits(), 0);
+        });
+    }
