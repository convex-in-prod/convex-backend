+        assert!(!cache.contains_key(&2));
+        assert_eq!(cache.len(), *MAX_REUSABLE_CONTEXTS_PER_ISOLATE);
+    }
+
+    #[test]
+    fn memory_pressure_evicts_window_then_weakest_protected_entry() {
+        let mut cache = fill_cache();
