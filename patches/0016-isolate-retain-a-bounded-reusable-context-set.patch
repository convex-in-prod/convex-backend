+        );
+        assert!(evicted[1..].iter().all(|key| *key >= 3));
+        assert!(cache.contains_key(&1));
+        assert!(cache.contains_key(&2));
+    }
+
+    #[test]
+    fn cgroup_pressure_removes_a_partial_cache_probationary_resident() {
+        let mut cache = TinyLfuCache::new();
