+        }));
+    }
+
+    #[test]
+    fn no_growth_admission_does_not_fill_an_empty_protected_slot() {
+        let mut cache = TinyLfuCache::new();
+        for key in 1..=3 {
+            assert!(miss_and_save(&mut cache, key).candidate_admitted);
+        }
+
+        let insertion = cache.insert_new_without_growth(4, 4);
