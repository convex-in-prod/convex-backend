+    }
+
+    #[test]
+    fn hot_protected_context_returning_during_pressure_competes_for_two_slots() {
+        let mut cache = fill_cache();
+        for _ in 0..3 {
+            hit_and_return(&mut cache, 1);
+        }
+        for _ in 0..2 {
+            hit_and_return(&mut cache, 2);
+        }
+        let returning = cache
+            .take(&1)
