+    #[test]
+    fn action_function_cap_isolates_http_routes_within_the_global_cap() {
+        let tokio = ProdRuntime::init_tokio().unwrap();
+        let rt = SchedulerTestRuntime::new(ProdRuntime::new(&tokio));
+        let mut harness = SchedulerHarness::new(rt, 4, 3, 2, 100, 8);
+        let started = harness.started_sender.clone();
+        let http_request = |id, route| {
+            let mut pending = test_request(id, TestRequestKind::Action, started.clone());
+            let RequestType::Test {
+                action_function,
+                http_route,
+                ..
+            } = &mut pending.request.inner
+            else {
+                unreachable!()
+            };
+            action_function.udf_path = "http:default".parse().unwrap();
+            *http_route = route;
+            pending
+        };
+        let bulk_route = HttpActionRoute {
+            method: RoutableMethod::Get,
+            path: "/bulk/*".into(),
+            matched: true,
+        };
+        let bulk = http_request(1, Some(bulk_route.clone()));
+        let same_route = http_request(2, Some(bulk_route.clone()));
+        let auth = http_request(
+            3,
+            Some(HttpActionRoute {
+                path: "/session/*".into(),
+                ..bulk_route.clone()
+            }),
+        );
+        let other_method = http_request(
+            4,
+            Some(HttpActionRoute {
+                method: RoutableMethod::Post,
+                ..bulk_route
+            }),
+        );
+        let unmatched = http_request(5, None);
+        let another_unmatched = http_request(6, None);
+        let scheduler = &mut harness.pending_scheduler.as_mut().unwrap().1;
+        scheduler.max_independent_actions_per_function = 1;
+        let properties = bulk.request.scheduling_properties(false);
+        let eligible = |state: &SchedulerStateSnapshot, pending: &PendingTestRequest| {
+            state.can_start_request(
+                properties,
+                "deployment",
+                pending.request.independent_action_key().as_ref(),
+            )
+        };
+
+        scheduler.reserve_pending_permit(&bulk.request);
+        let state = scheduler.state_snapshot();
+        assert!(!eligible(&state, &same_route));
+        assert!(eligible(&state, &auth));
+        assert!(eligible(&state, &other_method));
+        assert!(eligible(&state, &unmatched));
+
+        scheduler.reserve_pending_permit(&auth.request);
+        assert!(!eligible(&scheduler.state_snapshot(), &other_method));
+        scheduler.release_pending_permit(&bulk.request);
+        assert!(eligible(&scheduler.state_snapshot(), &same_route));
+        scheduler.release_pending_permit(&auth.request);
+
+        scheduler.reserve_pending_permit(&unmatched.request);
+        let state = scheduler.state_snapshot();
+        assert!(!eligible(&state, &another_unmatched));
+        assert!(eligible(&state, &auth));
+        scheduler.release_pending_permit(&unmatched.request);
+        assert!(scheduler.independent_actions_by_function.is_empty());
+    }
+
