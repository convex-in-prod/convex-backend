+    anyhow::ensure!(
+        first.is_ascii_alphabetic() || matches!(first, b'_' | b':'),
+        "malloc_info tag or attribute name is invalid"
+    );
+    *index += 1;
+    while bytes.get(*index).is_some_and(|byte| {
+        byte.is_ascii_alphanumeric() || matches!(*byte, b'_' | b':' | b'.' | b'-')
+    }) {
+        *index += 1;
+    }
+    Ok(&xml[start..*index])
