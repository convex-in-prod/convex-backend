+        cache: &QueryCache,
+        key: &'a RequestedCacheKey,
+        stored_key_hint: Option<&StoredCacheKey>,
+        identity: &'a Identity,
+        ts: Timestamp,
+        execution_class: QueryExecutionClass,
+        miss_behavior: CacheMissBehavior,
+    ) -> Option<CachePlan<'a>> {
+        let now = tokio::time::Instant::now();
+        cache.plan_cache_op(
