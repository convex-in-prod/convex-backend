+    fn put_ready_at(cache: &QueryCache, key: &RequestedCacheKey, original_ts: Timestamp) {
+        cache
+            .inner
+            .lock()
+            .put_ready(key.precise_cache_key(), cache_result_at(key, original_ts));
+    }
