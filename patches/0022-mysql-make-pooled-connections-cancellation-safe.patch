+    ///
+    /// This does not drain pending results, roll back a transaction, or send
+    /// `COM_QUIT`. Use it only when an interrupted operation may have left the
+    /// protocol stream unusable.
+    pub fn force_disconnect(mut self) {
+        self.inner.disconnected = true;
+        let pool = self.inner.pool.take();
+        drop(self.inner.stream.take());
+        if let Some(pool) = pool {
+            pool.discard_in_use_connection();
+        }
+    }
