+        if !self.inner.disconnected {
+            self.inner.disconnected = true;
+            self.write_command_data(Command::COM_QUIT, &[]).await?;
+            let stream = self.take_stream();
+            stream.close().await?;
+        }
+        Ok(())
+    }
