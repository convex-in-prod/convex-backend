+        assert_eq!(collected, vec![(42u8,)]);
+        let result = conn.exec_iter(&stmt, (8_u8,)).await?;
+        let reduced = result
+            .reduce_and_drop(2, |mut acc, row| {
+                acc += from_row::<i32>(row);
