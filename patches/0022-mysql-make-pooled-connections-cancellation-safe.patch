+        conn.disconnect().await?;
+        assert_eq!(reduced, 10);
+
+        let mut conn = Conn::new(get_opts()).await?;
+        let stmt = conn.prep(r"SELECT :foo, :bar, :foo, 3").await?;
+        let result = conn
+            .exec_iter(&stmt, params! { "foo" => "quux", "bar" => "baz" })
+            .await?;
