+/// Pending result set.
+#[derive(Debug, Clone)]
+pub(crate) enum PendingResult {
+    /// There is a pending result set.
+    Pending(ResultSetMeta),
+    /// Result set metadata was taken but not yet consumed.
+    Taken(Arc<ResultSetMeta>),
+}
