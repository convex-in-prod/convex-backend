+    /// [2]: ../mysql_async/#local-infile-handlers
+    pub fn set_infile_handler<T>(&mut self, handler: T)
+    where
+        T: Future<Output = crate::Result<InfileData>>,
+        T: Send + Sync + 'static,
+    {
