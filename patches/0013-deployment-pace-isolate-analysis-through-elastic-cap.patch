+    capacity_reservation: Option<AnalysisCapacityReservation>,
+}
+
+impl AnalyzeResponseSender {
+    fn new(
+        sender: oneshot::Sender<AnalyzeResponse>,
+        capacity_reservation: Option<AnalysisCapacityReservation>,
+    ) -> Self {
